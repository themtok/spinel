{%% Rebar3 build configuration.
%% Pins educkui, applies its build hook, and sets up the shell and OTP release.

erl_opts, [debug_info, warnings_as_errors]}.
{minimum_otp_vsn, "28"}.
{deps, [{educkui, {git, "https://github.com/kasicass/educkui.git",
    {ref, "ab55dfafbbfad9f11b4795e334266bad8a676564"}}}]}.
%% The pinned educkui revision uses catch expressions, deprecated on OTP 29.
{overrides, [{add, educkui, [{erl_opts, [nowarn_deprecated_catch]}]}]}.
{post_hooks, [{compile, "escript scripts/patch_educkui.escript"}]}.

{shell, [
    {apps, [erl_harness]},
    {config, "config/sys.config"}
]}.

{relx, [
    {release, {erl_harness, "0.1.0"}, [sasl, erl_harness]},
    {extended_start_script, false}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod}]}]}
]}.
